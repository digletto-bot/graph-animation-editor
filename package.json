{
  "name": "line-bird",
  "version": "0.1.0",
  "description": "Embeddable player for Line Bird graph animations, and the editor that authors them",
  "type": "module",
  "files": [
    "dist/runtime"
  ],
  "exports": {
    ".": {
      "types": "./dist/runtime/types/index.d.ts",
      "import": "./dist/runtime/line-bird.js"
    },
    "./validate": {
      "types": "./dist/runtime/types/validate.d.ts",
      "import": "./dist/runtime/validate.js"
    },
    "./element": {
      "types": "./dist/runtime/types/element.d.ts",
      "import": "./dist/runtime/element.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/runtime/element.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:runtime",
    "build:runtime": "vite build --config vite.runtime.config.ts && tsc -p tsconfig.runtime.json",
    "prepack": "npm run build:runtime",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "canvas": "^3.2.3",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "konva": "^10.3.2"
  },
  "allowScripts": {
    "canvas@3.2.3": true
  }
}
